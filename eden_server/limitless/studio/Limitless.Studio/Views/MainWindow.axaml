<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Limitless.Studio.ViewModels"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        xmlns:icons="clr-namespace:SukiUI.Content;assembly=SukiUI"
        x:Class="Limitless.Studio.Views.MainWindow"
        Width="1240" Height="780" MinWidth="980" MinHeight="600"
        Title="Limitless Studio"
        BackgroundStyle="Flat"
        BackgroundShaderCode="vec4 main(vec2 fragCoord) { return vec4(0.059, 0.071, 0.125, 1.0); }"
        FontFamily="{DynamicResource EdenBodyFont}"
        x:DataType="vm:MainViewModel">

    <!-- Fond imposé : night #0F1220 (le shader « Flat » de SukiUI
         teinte le fond par la couleur primaire). -->
    <suki:SukiWindow.LogoContent>
        <Image Source="{Binding NavLogo}" Width="20" Height="20"
               VerticalAlignment="Center"/>
    </suki:SukiWindow.LogoContent>
    <suki:SukiWindow.RightWindowTitleBarControls>
        <TextBlock Classes="meta"
                   Text="{Binding BuildStamp, StringFormat='build {0}'}"
                   VerticalAlignment="Center" Margin="0,0,6,0"/>
    </suki:SukiWindow.RightWindowTitleBarControls>

    <Grid RowDefinitions="*,Auto">
        <suki:SukiSideMenu Grid.Row="0"
                           IsSearchEnabled="False"
                           IsMenuExpanded="True"
                           OpenPaneLength="200"
                           UseCustomContent="True"
                           Content="{Binding CurrentPage}"
                           SelectedItem="{Binding SelectedNavItem}">

            <suki:SukiSideMenu.HeaderContent>
                <StackPanel Margin="4,10,4,14" Spacing="2">
                    <TextBlock Text="Limitless Studio" Classes="h3"/>
                    <TextBlock Text="Eden Eternal toolset" Classes="meta"/>
                </StackPanel>
            </suki:SukiSideMenu.HeaderContent>

            <suki:SukiSideMenu.Items>
                <suki:SukiSideMenuItem Header="Items" Tag="items"
                                       IsSelected="True">
                    <suki:SukiSideMenuItem.Icon>
                        <Panel Width="18" Height="18">
                            <PathIcon Data="{x:Static icons:Icons.Star}"/>
                            <Image Source="{Binding NavIconItems}"/>
                        </Panel>
                    </suki:SukiSideMenuItem.Icon>
                </suki:SukiSideMenuItem>
                <suki:SukiSideMenuItem Header="Monsters" Tag="monsters">
                    <suki:SukiSideMenuItem.Icon>
                        <Panel Width="18" Height="18">
                            <PathIcon Data="{x:Static icons:Icons.CircleWarning}"/>
                            <Image Source="{Binding NavIconMonsters}"/>
                        </Panel>
                    </suki:SukiSideMenuItem.Icon>
                </suki:SukiSideMenuItem>
                <suki:SukiSideMenuItem Header="Icon finder" Tag="icons">
                    <suki:SukiSideMenuItem.Icon>
                        <Panel Width="18" Height="18">
                            <PathIcon Data="{x:Static icons:Icons.CircleOutline}"/>
                            <Image Source="{Binding NavIconIcons}"/>
                        </Panel>
                    </suki:SukiSideMenuItem.Icon>
                </suki:SukiSideMenuItem>
                <suki:SukiSideMenuItem Header="INI files" Tag="ini">
                    <suki:SukiSideMenuItem.Icon>
                        <Panel Width="18" Height="18">
                            <PathIcon Data="{x:Static icons:Icons.FileOpen}"/>
                            <Image Source="{Binding NavIconIni}"/>
                        </Panel>
                    </suki:SukiSideMenuItem.Icon>
                </suki:SukiSideMenuItem>
                <suki:SukiSideMenuItem Header="Client assets" Tag="assets">
                    <suki:SukiSideMenuItem.Icon>
                        <Panel Width="18" Height="18">
                            <PathIcon Data="{x:Static icons:Icons.Refresh}"/>
                            <Image Source="{Binding NavIconAssets}"/>
                        </Panel>
                    </suki:SukiSideMenuItem.Icon>
                </suki:SukiSideMenuItem>
            </suki:SukiSideMenu.Items>
        </suki:SukiSideMenu>

        <!-- Barre de statut -->
        <Border Grid.Row="1" Classes="panel" CornerRadius="0"
                BorderThickness="0,1,0,0" Padding="14,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}" Classes="meta"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Classes="meta"
                           Text="{Binding RepoPath}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</suki:SukiWindow>
