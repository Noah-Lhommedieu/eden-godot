<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>EdenClient.NetTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\godot_project\scripts\net\**\*.cs" />
    <Compile Include="..\..\godot_project\scripts\protocol\**\*.cs" />
    <Compile Include="..\..\godot_project\scripts\session\**\*.cs" />
    <Compile Include="..\..\godot_project\scripts\data\**\*.cs" Exclude="..\..\godot_project\scripts\data\tables\PartnerTable.cs;..\..\godot_project\scripts\data\DataWarmup.cs" />
    <!-- PartnerTable charge des icônes Texture2D — exclu comme
         CeguiToGodot.cs (dépendance GodotSharp). -->
    <Compile Include="..\..\godot_project\scripts\game\**\*.cs" Exclude="..\..\godot_project\scripts\game\CharVisual.cs;..\..\godot_project\scripts\game\AnimRetarget.cs;..\..\godot_project\scripts\game\EntityAnimator.cs;..\..\godot_project\scripts\game\EdenGltfMipmaps.cs;..\..\godot_project\scripts\game\CharBodyCache.cs" />
    <Compile Include="..\..\godot_project\scripts\input\PickCore.cs" />
    <Compile Include="..\..\godot_project\scripts\combat\CombatMessages.cs" />
    <Compile Include="..\..\godot_project\scripts\combat\MotionTable.cs" />
    <Compile Include="..\..\godot_project\scripts\combat\CombatFx.cs" />
    <Compile Include="..\..\godot_project\scripts\combat\CastLock.cs" />
    <Compile Include="..\..\godot_project\scripts\scene\SceneBubbleLogic.cs" />
    <Compile Include="..\..\godot_project\scripts\scene\MonsterActionAnim.cs" />
    <Compile Include="..\..\godot_project\scripts\scene\CinemaTimeline.cs" />
    <Compile Include="..\..\godot_project\scripts\ClientConfig.cs" />
    <Compile Include="..\..\godot_project\scripts\vfs\*.cs" />
    <!-- edenpack interne (writer + diff/apply/install) — tests E2E
         crypto/distribution sur le vrai code d'écriture -->
    <Compile Include="..\edenpack\EpkWriter.cs" />
    <Compile Include="..\edenpack\PackOps.cs" />
    <!-- settings : noyau pur (ClientSettings + plan InputBindings)
         testable sans GodotSharp — les parties Godot sont sous
         #if GODOT. -->
    <Compile Include="..\..\godot_project\scripts\settings\ClientSettings.cs" />
    <Compile Include="..\..\godot_project\scripts\settings\InputBindings.cs" />
    <!-- world/player : uniquement les classes pures (pas de Godot) -->
    <Compile Include="..\..\godot_project\scripts\world\FsmFile.cs" />
    <Compile Include="..\..\godot_project\scripts\world\TerrainSampler.cs" />
    <Compile Include="..\..\godot_project\scripts\world\NodeMapFile.cs" />
    <Compile Include="..\..\godot_project\scripts\world\Pathfinder.cs" />
    <Compile Include="..\..\godot_project\scripts\world\GrassLayout.cs" />
    <Compile Include="..\..\godot_project\scripts\world\IflFile.cs" />
    <Compile Include="..\..\godot_project\scripts\player\InterpBuffer.cs" />
    <!-- scripts/ui : le noyau pur (parseurs + spec) est testable sans
         GodotSharp ; seul CeguiToGodot.cs instancie des Controls et
         reste exclus. -->
    <Compile Include="..\..\godot_project\scripts\ui\**\*.cs" Exclude="..\..\godot_project\scripts\ui\CeguiToGodot.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
</Project>
