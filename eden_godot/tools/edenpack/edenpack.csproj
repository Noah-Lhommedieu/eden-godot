<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>edenpack</AssemblyName>
    <RootNamespace>EdenPack</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Noyau format EPK partagé avec le client — lien, pas de copie -->
    <Compile Include="..\..\godot_project\scripts\vfs\EpkFormat.cs" />
    <Compile Include="..\..\godot_project\scripts\vfs\EpkIndex.cs" />
    <Compile Include="..\..\godot_project\scripts\vfs\EpkReader.cs" />
    <Compile Include="..\..\godot_project\scripts\vfs\EpkCrypto.cs" />
    <Compile Include="..\..\godot_project\scripts\vfs\EpkManifest.cs" />
    <!-- bake-tables : parseur ini + format ITB1 partagés avec le client ;
         EdenVfs (partie pure #if !GODOT) pour le reroutage des lectures -->
    <Compile Include="..\..\godot_project\scripts\vfs\EdenVfs.cs" />
    <Compile Include="..\..\godot_project\scripts\data\IniTable.cs" />
    <Compile Include="..\..\godot_project\scripts\data\MyCrypt.cs" />
    <Compile Include="..\..\godot_project\scripts\data\EdenEncoding.cs" />
    <Compile Include="..\..\godot_project\scripts\data\TableBin.cs" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
</Project>
