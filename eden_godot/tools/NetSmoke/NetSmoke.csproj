<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NetSmoke</AssemblyName>
    <RootNamespace>EdenClient.NetSmoke</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Sources partagées avec le client Godot — pas de duplication -->
    <Compile Include="..\..\godot_project\scripts\net\**\*.cs" />
    <Compile Include="..\..\godot_project\scripts\protocol\**\*.cs" />
    <Compile Include="..\..\godot_project\scripts\session\**\*.cs" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
</Project>
