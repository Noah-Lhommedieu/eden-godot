# Copiez ce fichier en ".env" et adaptez les valeurs.
#   cp .env.example .env
# ".env" est git-ignoré (ne JAMAIS committer de vrais secrets).

# ---- PostgreSQL ----
# Réseau docker interne : Host=postgres Port=5432.
# Depuis l'hôte (start-native.sh, outils) : localhost:5433.
POSTGRES_PASSWORD=CHANGE_ME_strong_password
DB_CONN=Host=postgres;Port=5432;Database=edenfr_db;No Reset On Close=true;Username=postgres;Password=CHANGE_ME_strong_password
ACCOUNT_DB_CONN=Host=postgres;Port=5432;Database=edenfr_account;No Reset On Close=true;Username=postgres;Password=CHANGE_ME_strong_password

# ---- Réseau (ports d'écoute des services C#) ----
TICKET_PORT=2067
GATEWAY_PORT=5560
CGI_PORT=20205
# ---- IDs monde (cohérents avec l'ancien serveur) ----
WORLD_ID=1010
ZONE_ID=1011

# ---- IA locale (Ollama) ----
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
