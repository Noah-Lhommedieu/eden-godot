#!/usr/bin/env python3
"""Ré-extraction vérifiée du client EDENFR vers corpus/fr-v2 (plan A3).

  tools/edenfr-extract/edenfr-extract [--src ~/Téléchargements/EDENFR] [--dst corpus/fr-v2]

Sources, dans l'ordre : 1) pkg/pkg.idx + pkgNNN.pkg (inflate à fenêtre 64 Ko),
2) fichiers du dossier d'installation (sound/, bgm/, Movies/, racine…).
Une entrée n'est écrite que si taille ET CRC32C égalent ceux du manifeste
GameDataFileList.txt. Rapport : docs/provenance/edenfr-extract-<date>.tsv.
Format : docs/formats/PKG-FORMAT.md.
"""
import argparse, ctypes, datetime, os, struct, sys, zlib
from multiprocessing import Pool

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.abspath(os.path.join(HERE, '..', '..'))
sys.path.insert(0, os.path.join(ROOT, 'tools', 'edenfr-verify'))
HEADER, REC = 292, 592
_lib = None


def lib():
    global _lib
    if _lib is None:
        _lib = ctypes.CDLL(os.path.join(ROOT, 'tools', 'edenfr-verify', 'libcrc32c.so'))
        _lib.crc32c_buf.restype = ctypes.c_uint32
        _lib.crc32c_buf.argtypes = [ctypes.c_char_p, ctypes.c_size_t]
        _lib.inflate64.argtypes = [ctypes.c_char_p, ctypes.c_size_t, ctypes.c_char_p,
                                   ctypes.POINTER(ctypes.c_size_t), ctypes.c_int]
    return _lib


def crc32c(b):
    return lib().crc32c_buf(b, len(b))


def parse_index(path):
    d = open(path, 'rb').read()
    out = []
    for i in range((len(d) - HEADER) // REC):
        o = HEADER + i * REC
        off, zsize = struct.unpack_from('<IxxxxI', d, o + 4)
        crc, flags = struct.unpack_from('<QQ', d, o + 16)
        size, = struct.unpack_from('<I', d, o + 56)
        n2 = d[o + 60:o + 320].split(b'\0', 1)[0].decode('latin-1')
        n1 = d[o + 320:o + 580].split(b'\0', 1)[0].decode('latin-1')
        pkg, = struct.unpack_from('<I', d, o + 584)
        rel = (n1 + n2).replace('\\', '/').lstrip('/')
        parts = [p for p in rel.split('/') if p not in ('', '.')]
        if not parts or '..' in parts: raise ValueError('chemin dangereux : %r' % rel)
        if parts[0].lower() == 'uidata': parts[0] = 'uidata'
        out.append((i, pkg, off, zsize, size, flags, crc, '/'.join(parts)))
    return out


def unpack(raw, size, flags):
    """Décompresse une entrée. flags&0x40 : brut. zsize==size n'est PAS un
    indice de « brut » (S1762108.ifl : 28 o compressés en 28 o)."""
    if flags & 0x40:
        return raw
    try:
        return zlib.decompress(raw)          # petites entrées : zlib standard
    except zlib.error:
        pass
    if len(raw) == size and raw[:2] not in (b'\x88\x1c', b'\x78\x01', b'\x78\x9c', b'\x78\xda'):
        return raw
    buf = ctypes.create_string_buffer(size + 16)
    n = ctypes.c_size_t(size + 16)
    r = lib().inflate64(raw[2:], len(raw) - 2, buf, ctypes.byref(n), 0)
    if r != 0: raise ValueError('inflate64 code %d' % r)
    return buf.raw[:n.value]


def work(job):
    src, dst, (i, pkg, off, zsize, size, flags, crc, rel) = job
    try:
        with open(os.path.join(src, 'pkg', 'pkg%03d.pkg' % pkg), 'rb') as f:
            f.seek(off); raw = f.read(zsize)
        data = unpack(raw, size, flags)
    except Exception as e:
        return (rel, 'ERREUR-PKG', str(e))
    if len(data) != size or crc32c(data) != crc:
        return (rel, 'PKG-NONCONFORME', 'taille %d/%d' % (len(data), size))
    p = os.path.join(dst, rel)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, 'wb') as f: f.write(data)
    return (rel, 'OK-pkg', '')


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--src', default=os.path.expanduser('~/Téléchargements/EDENFR'))
    ap.add_argument('--dst', default=os.path.join(ROOT, 'corpus', 'fr-v2'))
    a = ap.parse_args()
    man = {}
    for l in open(os.path.join(a.src, 'GameDataFileList.txt'), encoding='latin-1'):
        p = l.rstrip('\r\n').split(':')
        if len(p) >= 4: man[p[0].replace('\\', '/')] = (int(p[2]), int(p[3]))
    mlow = {k.lower(): v for k, v in man.items()}
    idx = parse_index(os.path.join(a.src, 'pkg', 'pkg.idx'))
    with Pool(os.cpu_count()) as pool:
        res = pool.map(work, [(a.src, a.dst, e) for e in idx], chunksize=64)
    done = {r[0].lower() for r in res if r[1] == 'OK-pkg'}
    # entrées du manifeste hors pkg : dossier d'installation
    inst = {}
    for d, _, fs in os.walk(a.src):
        if os.path.relpath(d, a.src).split(os.sep)[0] in ('pkg', 'extracted', 'qb_out', 'decomp', 'tmpwork', 'Temp'): continue
        for f in fs:
            p = os.path.join(d, f)
            inst.setdefault(os.path.relpath(p, a.src).replace(os.sep, '/').lower(), p)
    for name, (size, crc) in man.items():
        if name.lower() in done: continue
        p = inst.get(name.lower())
        if not p: res.append((name, 'ABSENT', '')); continue
        b = open(p, 'rb').read()
        # Copie d'installation : gardée telle quelle même si le CRC diffère (c'est
        # ce que lit le client d'origine), mais signalée.
        if len(b) != size: res.append((name, 'INSTALL-TAILLE-DIFFERENTE', p)); continue
        q = os.path.join(a.dst, name); os.makedirs(os.path.dirname(q), exist_ok=True)
        open(q, 'wb').write(b)
        res.append((name, 'OK-install' if crc32c(b) == crc else 'INSTALL-CRC-DIFFERENT', p))
    mk = {m.lower() for m in man}
    for r in res:
        if r[1] == 'OK-pkg' and r[0].lower() not in mk: res[res.index(r)] = (r[0], 'OK-pkg-HORS-MANIFESTE', '')
    cnt = {}
    for r in res: cnt[r[1]] = cnt.get(r[1], 0) + 1
    rep = os.path.join(ROOT, 'docs', 'provenance', 'edenfr-extract-%s.tsv' % datetime.date.today())
    os.makedirs(os.path.dirname(rep), exist_ok=True)
    with open(rep, 'w') as f:
        for r in sorted(res): f.write('\t'.join(r) + '\n')
    for k, v in sorted(cnt.items()): print('%-24s %d' % (k, v))
    print('rapport :', rep)


if __name__ == "__main__":
    main()
